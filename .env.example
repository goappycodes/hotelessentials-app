# ─── Supabase (Dashboard → Project Settings → API Keys → Legacy API keys) ──
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# anon (public) key — safe for the browser
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# service_role (secret) key — server-only, bypasses RLS. NEVER prefix with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=

# ─── Admin seeder (npm run db:seed) — local only, never add to Vercel ───────
ADMIN_SEED_EMAIL=admin@hotelessentials.com
ADMIN_SEED_PASSWORD=

# ─── Migrations only (npm run db:push / db:status) ─────────────────────────
# Uncomment temporarily when running migrations. Dashboard → Connect → Session pooler
# SUPABASE_DB_PASSWORD=
# SUPABASE_POOLER_HOST=aws-0-ap-northeast-2.pooler.supabase.com

# ─── Zoho Books (server-only) ──────────────────────────────────────────────
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_BOOKS_ORG_ID=
ZOHO_ACCOUNTS_BASE_URL=https://accounts.zoho.in
ZOHO_API_BASE_URL=https://www.zohoapis.in
# Quote + sales order webhooks: a long random value. Zoho sends it in the X-Zoho-Webhook-Secret header
# (add it under the webhook's HTTP Headers in Zoho Books); requests without it are rejected.
# Server-only, mark as Sensitive. The payload's organization_id must equal ZOHO_BOOKS_ORG_ID above.
# Optional: set to 1 to log every accepted webhook payload (rejected ones are always logged). Never logs the secret.
# ZOHO_WEBHOOK_DEBUG=1
ZOHO_WEBHOOK_SECRET=
